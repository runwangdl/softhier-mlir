 from pulp.chips.flex_cluster.hbm_ctrl import hbm_ctrl
 import memory.dramsys
 import math
+import os
+
+# --- DSE/aarch64 escape hatch -------------------------------------------------
+# DRAMSys ships as an x86-64-only .so; on an aarch64 host the Dramsys component
+# cannot be loaded and gvsoc segfaults at elaboration. Setting
+# SOFTHIER_IDEAL_HBM=1 swaps each HBM channel for gvsoc's plain `memory.memory`
+# model (ideal DRAM: fixed bandwidth, no refresh / bank conflicts / row policy).
+# Compute, TCDM, NoC and iDMA timing are untouched, so on-chip DSE knobs stay
+# meaningful; absolute HBM-bound numbers become optimistic.
+def _make_hbm_channel(parent, name, size, width_log2):
+    if os.environ.get('SOFTHIER_IDEAL_HBM', '0') == '1':
+        return memory.memory.Memory(parent, name, size=size, width_log2=width_log2)
+    return memory.dramsys.Dramsys(parent, name)
+# ------------------------------------------------------------------------------
 
 GAPY_TARGET = True
 
