--- core/models/cpu/iss/include/isa/rvXf16.hpp.orig	2026-10-08 11:38:50.048762006 +0000
+++ core/models/cpu/iss/include/isa/rvXf16.hpp	2026-10-08 11:38:50.063762006 +0000
@@ -27,17 +27,31 @@
 #include "cpu/iss/include/isa_lib/int.h"
 #include "cpu/iss/include/isa_lib/macros.h"
 
+// [SoftHier-fix] flh/fsh must go through the FLOAT register file with NaN-boxing (as flw/fsw
+// do); the stock code used the integer load/store and the integer regfile, so every Zfh
+// scalar load/store returned garbage. Mirrors flw_exec / fsw_exec in rvf.hpp.
 static inline iss_reg_t flh_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc)
 {
     iss->lsu.stack_access_check(REG_IN(0), REG_GET(0) + SIM_GET(0));
-    iss->lsu.load<uint16_t>(insn, REG_GET(0) + SIM_GET(0), 2, REG_OUT(0));
+    if (iss->lsu.load_float_perf<uint16_t>(insn, REG_GET(0) + SIM_GET(0), 2, REG_OUT(0)))
+    {
+        return pc;
+    }
     return iss_insn_next(iss, insn, pc);
 }
 
 static inline iss_reg_t fsh_exec(Iss *iss, iss_insn_t *insn, iss_reg_t pc)
 {
+    if (iss->csr.mstatus.fs == 0)
+    {
+        iss->exception.raise(pc, ISS_EXCEPT_ILLEGAL);
+        return pc;
+    }
     iss->lsu.stack_access_check(REG_OUT(0), REG_GET(0) + SIM_GET(0));
-    iss->lsu.store<uint16_t>(insn, REG_GET(0) + SIM_GET(0), 2, REG_IN(1));
+    if (iss->lsu.store_float_perf<uint16_t>(insn, REG_GET(0) + SIM_GET(0), 2, REG_IN(1)))
+    {
+        return pc;
+    }
     return iss_insn_next(iss, insn, pc);
 }
 
