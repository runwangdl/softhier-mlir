+// [SoftHier-perf] 256-entry table of fp8e4m3_to_float (identical values, no powf per MAC).
+static float fp8e4m3_lut(fp8e4m3 v) {
+    static float lut[256];
+    static bool init = false;
+    if (!init) { for (int i = 0; i < 256; ++i) lut[i] = fp8e4m3_to_float((fp8e4m3)i); init = true; }
+    return lut[v];
+}
