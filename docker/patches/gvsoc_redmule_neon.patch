+// Integer kernels: z[i][j] = (T)(y[i][j] + sum_k x[i][k]*w[k][j]) with wrap-around == original.
+template<typename T>
+static void matmul_int_generic(T *z, const T *y, const T *x, const T *w, int m, int n, int k)
+{
+    typedef typename std::conditional<std::is_signed<T>::value, int32_t, uint32_t>::type P;
+    enum { JB = 64 };
+    uint32_t acc[JB];
+    for (int i = 0; i < m; ++i) {
+        for (int j0 = 0; j0 < k; j0 += JB) {
+            const int nj = std::min<int>(JB, k - j0);
+            for (int jj = 0; jj < nj; ++jj) acc[jj] = (uint32_t)(P)y[(size_t)i * k + j0 + jj];
+            for (int kk = 0; kk < n; ++kk) {
+                const P a = (P)x[(size_t)i * n + kk];
+                const T *wr = w + (size_t)kk * k + j0;
+                for (int jj = 0; jj < nj; ++jj) acc[jj] += (uint32_t)(a * (P)wr[jj]);
             }
+            for (int jj = 0; jj < nj; ++jj) z[(size_t)i * k + j0 + jj] = (T)acc[jj];
         }
     }
 }
