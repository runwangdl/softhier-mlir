+// Column tail (k_size - j0 < 8): run the same FMA on a zero-padded 8-lane copy (padding lanes
+// compute 0*0+0 and are discarded).
+REDMULE_FP16_TARGET static void
+redmule_fp16_tail(fp16 *z, const fp16 *x, const fp16 *w, int n_size, int k_size, int j0)
+{
+    const int nj = k_size - j0;
+    uint16_t tz[8] = {0}, tb[8] = {0};
+    memcpy(tz, z + j0, nj * sizeof(fp16));
+    float16x8_t acc = vreinterpretq_f16_u16(vld1q_u16(tz));
+    for (int kk = 0; kk < n_size; ++kk) {
+        memcpy(tb, w + (size_t)kk * k_size + j0, nj * sizeof(fp16));
+        float16x8_t a = vreinterpretq_f16_u16(vdupq_n_u16(x[kk]));
+        acc = vfmaq_f16(acc, a, vreinterpretq_f16_u16(vld1q_u16(tb)));
+    }
+    vst1q_u16(tz, vreinterpretq_u16_f16(acc));
+    memcpy(z + j0, tz, nj * sizeof(fp16));
+}
+
+// The Snitch ISS emulates RISC-V rounding modes with fesetround() on the host and can leave the
+// thread in RTZ/RDN/RUP; the hand-written converter of the scalar path ignores that, vfmaq_f16
+// does not.  Force IEEE RNE with fp16/fp32 flush-to-zero off for the duration of the kernel.
+static inline uint64_t redmule_fpcr_get(void) { uint64_t v; __asm__ volatile("mrs %0, fpcr" : "=r"(v)); return v; }
+static inline void     redmule_fpcr_set(uint64_t v) { __asm__ volatile("msr fpcr, %0" : : "r"(v)); }
+#define REDMULE_FPCR_MASK ((3ull << 22) | (1ull << 24) | (1ull << 19))   // RMode, FZ, FZ16
+
+REDMULE_FP16_TARGET static void
+matmul_fp16_neon(fp16 *z, const fp16 *y, const fp16 *x, const fp16 *w, int m, int n, int k)
+{
+    const uint64_t fpcr_saved = redmule_fpcr_get();
+    redmule_fpcr_set(fpcr_saved & ~REDMULE_FPCR_MASK);
+    if (z != y) memmove(z, y, (size_t)m * k * sizeof(fp16));     // z = y (same buffer in the model)
+    const int k32 = k & ~31, k8 = k & ~7;
+    int i = 0;
+    for (; i + 4 <= m; i += 4) {                                  // 4 rows x 32 cols = 16 accumulators
+        fp16 *zi = z + (size_t)i * k; const fp16 *xi = x + (size_t)i * n;
+        int j = 0;
+        for (; j < k32; j += 32) redmule_fp16_block<4, 4>(zi, xi, w, n, k, j);
+        for (; j < k8;  j += 8)  redmule_fp16_block<4, 1>(zi, xi, w, n, k, j);
+        if (j < k) for (int r = 0; r < 4; ++r) redmule_fp16_tail(zi + (size_t)r * k, xi + (size_t)r * n, w, n, k, j);
+    }
+    for (; i < m; ++i) {
+        fp16 *zi = z + (size_t)i * k; const fp16 *xi = x + (size_t)i * n;
+        int j = 0;
+        for (; j < k32; j += 32) redmule_fp16_block<1, 4>(zi, xi, w, n, k, j);
+        for (; j < k8;  j += 8)  redmule_fp16_block<1, 1>(zi, xi, w, n, k, j);
+        if (j < k) redmule_fp16_tail(zi, xi, w, n, k, j);
+    }
+    redmule_fpcr_set(fpcr_saved);
+}
+#endif // __aarch64__
+
+void matmul_fp16(fp16 * z, fp16 * y, fp16 * x, fp16 * w, uint16_t m_size, uint16_t n_size, uint16_t k_size){
+#if defined(__aarch64__)
+    if (redmule_host_has_fp16()) { matmul_fp16_neon(z, y, x, w, m_size, n_size, k_size); return; }
+#endif
+    matmul_fp16_scalar(z, y, x, w, m_size, n_size, k_size);
+}
