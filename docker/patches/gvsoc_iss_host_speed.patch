 } iss_insn_t;
 
 
+// [SoftHier-fast] Instruction classes derived from the decoder label. The Snitch model used to
+// run up to 26 strstr() on insn->decoder_item->u.insn.label per instruction (decode.cpp offload
+// handlers, snitch.cpp handle_result, snitch_fp_ss.cpp get_latency). The expressions below are
+// exactly the original ones (substring matches included), evaluated once per decoded instruction
+// and cached in the instruction (copies carry the cache along).
+#define ISS_LABEL_VALID    (1 << 0)
+#define ISS_LABEL_FLSU     (1 << 1)  // flw fsw fld fsd
+#define ISS_LABEL_ILSU     (1 << 2)  // lw sw ld sd
+#define ISS_LABEL_FMA      (1 << 3)  // add sub mul mac
+#define ISS_LABEL_DIVSQRT  (1 << 4)  // div sqrt
+#define ISS_LABEL_NONCOMP  (1 << 5)  // sgnj min max
+#define ISS_LABEL_CONV     (1 << 6)  // fmv fcvt fcpka feq fle flt class
+#define ISS_LABEL_DOTP     (1 << 7)  // dotp sum
+
+static inline unsigned int iss_insn_label_class_compute(iss_insn_t *insn)
+{
+    const char *l = insn->decoder_item->u.insn.label;
+    unsigned int c = ISS_LABEL_VALID;
+    if (strstr(l, "flw") || strstr(l, "fsw") || strstr(l, "fld") || strstr(l, "fsd"))
+        c |= ISS_LABEL_FLSU;
+    if (strstr(l, "lw") || strstr(l, "sw") || strstr(l, "ld") || strstr(l, "sd"))
+        c |= ISS_LABEL_ILSU;
+    if (strstr(l, "add") || strstr(l, "sub") || strstr(l, "mul") || strstr(l, "mac"))
+        c |= ISS_LABEL_FMA;
+    if (strstr(l, "div") || strstr(l, "sqrt"))
+        c |= ISS_LABEL_DIVSQRT;
+    if (strstr(l, "sgnj") || strstr(l, "min") || strstr(l, "max"))
+        c |= ISS_LABEL_NONCOMP;
+    if (strstr(l, "fmv") || strstr(l, "fcvt") || strstr(l, "fcpka") || strstr(l, "feq") ||
+        strstr(l, "fle") || strstr(l, "flt") || strstr(l, "class"))
+        c |= ISS_LABEL_CONV;
+    if (strstr(l, "dotp") || strstr(l, "sum"))
+        c |= ISS_LABEL_DOTP;
+    insn->label_class = c;
+    return c;
+}
+
+static inline unsigned int iss_insn_label_class(iss_insn_t *insn)
+{
+    if (__builtin_expect(insn->label_class & ISS_LABEL_VALID, 1))
+        return insn->label_class;
+    return iss_insn_label_class_compute(insn);
+}
+
